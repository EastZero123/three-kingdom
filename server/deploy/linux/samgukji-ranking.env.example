# 온라인 랭킹 서버 환경 변수. install.sh가 /etc/samgukji-ranking.env 로 복사한다 (처음 한 번만, root만 읽기 가능).
# 복사된 파일을 열어 DB_PASSWORD 등을 채운 뒤:  sudo systemctl restart samgukji-ranking

DB_URL=jdbc:mysql://localhost:3306/samgukji_ranking?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=cdy
DB_PASSWORD=CHANGE_ME
PORT=9090

# 아래 두 값은 install.sh가 설치하는 위치다. 다른 곳에 설치했다면 바꾼다.
GODOT_PATH=/opt/samgukji/godot/godot
GAME_PROJECT_PATH=/opt/samgukji/game
